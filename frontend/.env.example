# Frontend runtime configuration — copy to `.env.local` for machine-specific overrides.
# Only VITE_-prefixed variables reach the browser, so nothing here may be secret.

# Public base path of the REST API as seen by the browser.
# Keep the `/api` prefix so the Vite dev proxy (vite.config.ts) can forward it.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards `/api` during `npm run dev:frontend`.
VITE_DEV_API_TARGET=http://localhost:4000
