# ---------------------------------------------------------------------------
# database environment — consumed by `npm run db:*` (database/scripts/run.mjs).
# Copy to database/.env (git-ignored) or rely on the repository root .env.
# The values below are local-development placeholders, NOT real credentials.
# ---------------------------------------------------------------------------

# Preferred: a single connection string.
DATABASE_URL=postgres://esrs:replace-with-a-local-only-password@localhost:5432/esrs

# Alternative: discrete variables (docker-compose.yml exposes these).
# The runner composes a URL from them when DATABASE_URL is unset.
POSTGRES_USER=esrs
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=esrs
POSTGRES_PORT=5432

# `npm run db:seed` hashes this with bcrypt (cost 12) and injects it into
# seeds/002_demo_data.sql, replacing {{DEMO_PASSWORD_HASH}}. There is no fallback value in the
# code: seeding demo data fails until you set this. Demo accounts are created with
# must_change_password = true, and this placeholder must never exist in a real environment.
SEED_DEMO_PASSWORD=choose-a-local-demo-password-only
