# ---------------------------------------------------------------------------
# backend environment — copy to backend/.env (git-ignored). Values below are
# local-development placeholders, NOT credentials.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
SERVICE_NAME=esrs-api
LOG_LEVEL=info

# Database. Leave DATABASE_URL unset to run the API without Postgres:
# /health/ready then reports database.state="not_configured" and the service still boots
# (useful for frontend work and CI). Start the container with `npm run db:up`.
DATABASE_URL=postgres://esrs:replace-with-a-local-only-password@localhost:5432/esrs
DATABASE_POOL_MAX=10
STATEMENT_TIMEOUT_MS=5000

# Auth. JWT_ACCESS_SECRET is required in production — the app refuses to boot there without it.
# In development a clearly-labelled ephemeral secret is generated so nobody commits one.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# iss/aud are verified on every token so one minted by another service is rejected.
JWT_ISSUER=esrs-api
JWT_AUDIENCE=esrs-web
# bcrypt work factor (policy default 12; lower only in tests).
BCRYPT_ROUNDS=12
# Account lockout: LOGIN_MAX_FAILURES consecutive failures lock the account for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Login rate limiting (per client IP, fixed window). The /auth/login route throttles to
# RATE_LIMIT_LOGIN_MAX requests per RATE_LIMIT_WINDOW_MS and answers 429 RATE_LIMITED beyond that.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10

# Comma-separated allowed browser origins for CORS (the Vite dev server in development).
# In production this MUST be the real web origin — the API refuses to boot with a localhost value.
CORS_ORIGINS=http://localhost:5173

# HTTP hardening.
# TRUST_PROXY = number of proxies in front of the API (0 when reachable directly, 1 behind nginx).
# BODY_LIMIT_KB = JSON payload cap (attachment uploads are multipart and capped separately).
TRUST_PROXY=0
BODY_LIMIT_KB=64
