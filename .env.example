# ---------------------------------------------------------------------------
# ESRS root environment — consumed by docker compose and copied into the
# per-package .env files by convention.
#   cp .env.example .env      (never commit .env)
# The values below are local-development placeholders, NOT real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=esrs
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=esrs
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- Connection strings used by backend / database packages ---
DATABASE_URL=postgres://esrs:replace-with-a-local-only-password@localhost:5432/esrs
DATABASE_URL_TEST=postgres://esrs:replace-with-a-local-only-password@localhost:5433/esrs_test
